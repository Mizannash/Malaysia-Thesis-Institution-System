# ── LLM (pick one; both optional in DEMO_MODE) ──
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=deepseek-chat

# ── Data sources ──
OPENALEX_EMAIL=your@email.com        # free, not a secret; required for live OpenAlex
SERPAPI_KEY=                          # optional; Google Scholar via SerpApi (disabled by default)

# ── Mode ──
DEMO_MODE=false

# ── Security & Authentication ──
APP_SECRET=change-me-mtis-secret-key-32charsmin

# ── Database ──
DATABASE_URL=postgresql://user:password@localhost:5432/malaysian_thesis_institution_system_mtis
REDIS_URL=redis://localhost:6379/0

# ── Supabase Auth & Postgres (Optional when DEMO_MODE=true) ──
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=

# ── Sign-in, messages and billing ──
EMAIL_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
