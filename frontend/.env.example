# MTIS Frontend Environment Configuration

# Backend API Base URL
# - For local development: http://localhost:8000
# - For cloud deployment on Netlify: Set this to your live FastAPI backend URL (e.g., https://mtis-backend.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo Mode (enables zero-key fixture testing and demo student logins)
NEXT_PUBLIC_DEMO_MODE=true

# Optional: Supabase OAuth credentials (only if enabling live Google Sign-In)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
